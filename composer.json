{
    "name": "antonio-sugamele/plugin-routes",
    "description": "Libreria per Laravel per la lettura e visualizzazione semplificata delle rotte.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "AntonioSugamele\\PluginRoutes\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AntonioSugamele\\PluginRoutes\\PluginRoutesServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "antsug83dev"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url":  "C:/web/Personali/PHP-LARAVEL/plugin-routes",
            "options": {
                "symlink": true
            }
        }
    ]
}